#!/usr/bin/env bash
# BD Deck installeren op Linux Mint: alles wat de app nodig heeft, plus de nieuwste versie van de app.
#
#   curl -fsSL https://raw.githubusercontent.com/ICTtrying/bd-deck/main/bin/install-mint | bash
#   bash install-mint [pad/naar/BD-Deck.AppImage] [--zonder-vscode]
#
# Installeert (alleen wat ontbreekt): git, rsync, ssh, lftp, curl, Docker, DDEV + mkcert, VS Code, GitHub CLI,
# maakt een SSH-sleutel (~/.ssh/id_ed25519) en zet de app in ~/Applications met een starter in het app-menu.
# Veilig om opnieuw te draaien. Vraagt één keer je wachtwoord (sudo).
set -euo pipefail

# alles in main: bij curl | bash leest bash eerst het hele script, zodat geen enkel programma de rest via stdin opeet
main() {

step() { printf '\n→ %s\n' "$*"; }
ok()   { printf '✓ %s\n' "$*"; }
note() { printf '· %s\n' "$*"; }
warn() { printf '! %s\n' "$*" >&2; }
die()  { printf '✗ %s\n' "$*" >&2; exit 1; }
has()  { command -v "$1" >/dev/null 2>&1; }

APPIMAGE_SRC="" WITH_VSCODE=1
for arg in "$@"; do
  case "$arg" in
    --zonder-vscode) WITH_VSCODE=0;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0;;
    *) APPIMAGE_SRC="$arg";;
  esac
done

REPO="${BD_DECK_REPOSITORY:-ICTtrying/bd-deck}"
[ "$(id -u)" != 0 ] || die "Draai dit als jezelf, niet met sudo. Het script vraagt zelf om je wachtwoord."
[ -r /etc/os-release ] && . /etc/os-release
[ "${ID:-}" = linuxmint ] || die "Dit script is (voorlopig) alleen voor Linux Mint."
# Mint noemt zijn eigen versie in VERSION_CODENAME; de pakketbronnen van Docker kennen alleen de Ubuntu-naam
DISTRO=ubuntu; CODENAME="${UBUNTU_CODENAME:-}"
[ -n "$CODENAME" ] || die "Kon de Ubuntu-basis van je Mint-versie niet bepalen (LMDE wordt niet ondersteund)."
# via curl | bash is $0 gewoon "bash": dan is er geen map met meegeleverde bestanden
HERE=""; [ -f "$0" ] && HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
RELOGIN=0

echo "BD Deck installeren op ${PRETTY_NAME:-Linux} ($DISTRO $CODENAME)"
sudo -v || die "Zonder beheerdersrechten kan er niets geïnstalleerd worden."
# sudo wakker houden tot het script klaar is
( while kill -0 $$ 2>/dev/null; do sudo -n true 2>/dev/null; sleep 50; done ) &

apt_install() { sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "$@" >/dev/null; }
add_repo() {  # naam sleutel-url regel
  sudo install -m 0755 -d /etc/apt/keyrings
  curl -fsSL "$2" | sudo gpg --dearmor --yes -o "/etc/apt/keyrings/$1.gpg"
  sudo chmod a+r "/etc/apt/keyrings/$1.gpg"
  echo "$3" | sudo tee "/etc/apt/sources.list.d/$1.list" >/dev/null
}

step "Basisprogramma's"
sudo apt-get update -qq
apt_install git rsync openssh-client python3 curl lftp ca-certificates gnupg xdg-utils libnss3-tools
# AppImages hebben FUSE 2 nodig; vanaf Mint 22 / Ubuntu 24.04 heet het pakket libfuse2t64
apt_install libfuse2t64 2>/dev/null || apt_install libfuse2 2>/dev/null || warn "libfuse2 niet geïnstalleerd; de AppImage start dan mogelijk niet."
ok "git, rsync, ssh, python3, curl, lftp"

step "Docker"
if has docker; then
  note "Docker staat er al ($(docker --version 2>/dev/null | cut -d, -f1))"
else
  add_repo docker "https://download.docker.com/linux/$DISTRO/gpg" \
    "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/$DISTRO $CODENAME stable"
  sudo apt-get update -qq
  apt_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  ok "Docker geïnstalleerd"
fi
sudo systemctl enable --now docker >/dev/null 2>&1 || true
if ! id -nG "$USER" | tr ' ' '\n' | grep -qx docker; then
  sudo usermod -aG docker "$USER"; RELOGIN=1
  ok "Je account mag Docker gebruiken (na opnieuw inloggen)"
fi

step "DDEV (lokale WordPress- en Laravel-sites)"
if has ddev; then
  note "DDEV staat er al ($(ddev --version 2>/dev/null | head -1))"
else
  add_repo ddev "https://pkg.ddev.com/apt/gpg.key" "deb [signed-by=/etc/apt/keyrings/ddev.gpg] https://pkg.ddev.com/apt/ * *"
  sudo apt-get update -qq
  apt_install ddev
  ok "DDEV geïnstalleerd"
fi
# vertrouwd https-certificaat voor *.ddev.site in je browsers
if has mkcert; then mkcert -install >/dev/null 2>&1 && ok "Lokale https-certificaten vertrouwd" || warn "mkcert -install mislukt; draai het later zelf."; fi

if [ $WITH_VSCODE = 1 ]; then
  step "VS Code"
  if has code; then note "VS Code staat er al"
  else
    add_repo packages.microsoft "https://packages.microsoft.com/keys/microsoft.asc" \
      "deb [arch=amd64,arm64,armhf signed-by=/etc/apt/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main"
    sudo apt-get update -qq
    apt_install code && ok "VS Code geïnstalleerd" || warn "VS Code niet geïnstalleerd; kies in BD Deck een andere editor."
  fi
fi

step "GitHub CLI (optioneel: privé repo per site)"
if has gh; then note "gh staat er al"; else apt_install gh 2>/dev/null && ok "gh geïnstalleerd (inloggen: gh auth login)" || note "gh niet beschikbaar in de pakketbronnen; overgeslagen"; fi

step "Git"
# bij curl | bash is stdin het script zelf: vragen gaan dan via /dev/tty
if [ -z "$(git config --global user.name 2>/dev/null || true)" ] && [ -r /dev/tty ]; then
  read -r -p "  Je naam voor commits: " gname </dev/tty || gname=""
  read -r -p "  Je e-mailadres voor commits: " gmail </dev/tty || gmail=""
  [ -n "$gname" ] && git config --global user.name "$gname"
  [ -n "$gmail" ] && git config --global user.email "$gmail"
fi
note "Commits als: $(git config --global user.name 2>/dev/null || echo 'wpopen') <$(git config --global user.email 2>/dev/null || echo 'wpopen@localhost')>"

step "SSH-sleutel"
mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
if [ -f "$HOME/.ssh/id_ed25519" ]; then
  note "Je hebt al een sleutel: ~/.ssh/id_ed25519"
else
  ssh-keygen -q -t ed25519 -a 64 -N "" -C "$USER@$(hostname)" -f "$HOME/.ssh/id_ed25519"
  ok "Nieuwe sleutel gemaakt: ~/.ssh/id_ed25519 (de private sleutel blijft op deze computer)"
fi
echo "  Publieke sleutel (zet deze bij WPMU DEV of Hostinger, zie Aan de slag in de app):"
echo "  $(cat "$HOME/.ssh/id_ed25519.pub")"

step "De app"
TARGET="$HOME/Applications/BD-Deck.AppImage"
mkdir -p "$HOME/Applications"
SRC="${APPIMAGE_SRC:-${APPIMAGE:-}}"
if [ -n "$SRC" ] && [ -f "$SRC" ]; then
  SRC=$(readlink -f "$SRC")
  if [ "$SRC" != "$(readlink -f "$TARGET" 2>/dev/null || true)" ]; then cp "$SRC" "$TARGET.new" && mv -f "$TARGET.new" "$TARGET"; fi
  ok "BD Deck overgenomen uit $SRC"
else
  # nieuwste release van GitHub; de app werkt zichzelf daarna bij
  url=$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" | python3 -c 'import json, sys; print(next((a["browser_download_url"] for a in json.load(sys.stdin).get("assets", []) if a["name"].endswith(".AppImage")), ""))' || true)
  [ -n "$url" ] || die "Geen BD Deck-release gevonden op https://github.com/$REPO/releases"
  note "Downloaden: $url"
  curl -fL --progress-bar -o "$TARGET.new" "$url" || die "Downloaden mislukt."
  mv -f "$TARGET.new" "$TARGET"
  ok "Nieuwste BD Deck gedownload"
fi
chmod +x "$TARGET"
icon_dir="$HOME/.local/share/icons/hicolor/512x512/apps"; mkdir -p "$icon_dir"
tmp=$(mktemp -d)
if (cd "$tmp" && "$TARGET" --appimage-extract '*.png' >/dev/null 2>&1) && [ -f "$tmp/squashfs-root/bd-deck.png" ]; then
  cp "$tmp/squashfs-root/bd-deck.png" "$icon_dir/bd-deck.png"
fi
rm -rf "$tmp"
desktop="$HOME/.local/share/applications/bd-deck.desktop"; mkdir -p "$(dirname "$desktop")"
cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=BD Deck
Comment=Lokale en live WordPress- en Laravel-sites beheren
Exec="$TARGET" %U
Icon=bd-deck
Terminal=false
Categories=Development;
StartupWMClass=BD Deck
EOF
chmod +x "$desktop"
desk_dir=$(xdg-user-dir DESKTOP 2>/dev/null || echo "$HOME/Desktop")
if [ -d "$desk_dir" ]; then cp "$desktop" "$desk_dir/bd-deck.desktop"; chmod +x "$desk_dir/bd-deck.desktop"; gio set "$desk_dir/bd-deck.desktop" metadata::trusted true 2>/dev/null || true; fi
update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
ok "BD Deck staat in ~/Applications, je app-menu en op je bureaublad"

# wpopen in je terminal (de app installeert hem ook zelf bij de eerste start)
if [ -n "$HERE" ] && [ -f "$HERE/wpopen" ]; then bash "$HERE/wpopen" install >/dev/null 2>&1 && ok "wpopen staat in ~/.local/bin" || true; fi

echo
ok "Klaar."
if [ $RELOGIN = 1 ]; then
  echo "  Log één keer uit en weer in (of herstart), zodat Docker zonder sudo werkt. Start daarna BD Deck."
else
  echo "  Start BD Deck vanuit je app-menu."
fi
}

main "$@"
