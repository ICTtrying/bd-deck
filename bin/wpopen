  export-sites) shift; cmd_export_sites "$@";;
  import-sites) shift; cmd_import_sites "$@";;
  add)      shift; cmd_add "$@";;
  update)   shift; cmd_update "$@";;
  remove)   shift; cmd_remove "$@";;
  new)      shift; cmd_new "$@";;
  multisite) shift; cmd_multisite "$@";;
  migrate)  shift; cmd_migrate "$@";;
  domain)   shift; cmd_domain "$@";;
  golive)   shift; cmd_golive "$@";;
  list)     shift; cmd_list "$@";;
  "")       cmd_list;;
  info)     shift; cmd_info "$@";;
  open)     shift; cmd_open "$@";;
  build)    shift; cmd_build "$@";;
  start|stop) cmd_startstop "$@";;
  pull)     shift; cmd_pull "$@";;
  reset)    shift; cmd_reset "$@";;
  rebuild)  shift; cmd_rebuild "$@";;
  fix)      shift; cmd_fix "$@";;
  live|push) shift; cmd_live "$@";;
