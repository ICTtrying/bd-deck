  for a in "$@"; do case "$a" in --yes|-y) export WPO_YES=1;; --no-launch) export WPO_NO_LAUNCH=1;; *) args+=("$a");; esac; done
  set -- "${args[@]+"${args[@]}"}"
fi
migrate_db
case "$(basename "$0")" in wplive) cmd_live "$@"; exit;; esac
case "${1:-}" in
